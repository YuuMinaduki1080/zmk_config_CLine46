#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// 日本語キー定義
#define JP_YEN          0x89              // ¥
#define JP_PIPE         LS(0x89)          // |
#define JP_UNDERSCORE   LS(0x87)          // _

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Colon {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <7 8>;  // U + I
            layers = <0>;
        };

        Semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <8 9>;  // I + O
            layers = <0>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <14 15>;  // S + D
            layers = <0>;
        };

        HankakuZenkaku {
            bindings = <&kp CAPSLOCK>;
            key-positions = <15 16>;  // D + F
            layers = <0>;
        };

        pipe {
            bindings = <&kp JP_PIPE>;
            key-positions = <19 20>;  // J + K
            layers = <0>;
        };

        Equal {
            bindings = <&kp LS(MINUS)>;
            key-positions = <20 21>;  // K + L
            layers = <0>;
        };

        Underscore {
            bindings = <&kp JP_UNDERSCORE>;
            key-positions = <21 22>;  // L + -
            layers = <0>;
        };

        Namisen {
            bindings = <&kp PLUS>;
            key-positions = <32 33>;  // , + .
            layers = <0>;
        };
    };

    macros {
        Space_Down: Space_Down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp DOWN_ARROW>;
            label = "SPACE_DOWN";
        };

        down_space: down_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOWN_ARROW &kp SPACE>;
            label = "DOWN_SPACE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB         &kp Q    &kp W         &kp E         &kp R             &kp T                                      &kp Y         &kp U        &kp I      &kp O    &kp P      &kp EQUAL
&kp CAPSLOCK    &kp A    &kp S         &kp D         &kp F             &kp G                                      &kp H         &kp J        &kp K      &kp L    &kp MINUS  &kp JP_UNDERSCORE
&kp LEFT_SHIFT  &kp Z    &kp X         &kp C         &kp V             &kp B                                      &kp N         &kp M        &kp COMMA  &kp DOT  &kp SLASH  &kp RIGHT_SHIFT
                &kp ESC  &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp SPACE  &kp BACKSPACE     &lt 1 DELETE  &lt 2 ENTER                &mo 7      &to 3
            >;
        };

        MARK {
            bindings = <
&kp TAB         &trans               &kp LC(LG(LEFT_ARROW))  &kp LG(TAB)   &kp LC(LG(RIGHT_ARROW))  &trans                                 &kp EQUAL    &kp LEFT_BRACE  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp LEFT_BRACKET  &trans
&kp CAPSLOCK    &kp RS(N1)           &kp RS(N2)              &kp RS(N3)    &kp RS(N4)               &kp RS(N5)                             &kp LS(N6)   &kp LS(N7)      &kp LS(N8)         &kp LS(N9)     &kp SINGLE_QUOTE  &kp SEMICOLON
&kp LEFT_SHIFT  &kp SLASH            &kp DOUBLE_QUOTES       &kp MINUS     &kp COLON                &kp LC(PAUSE_BREAK)                    &kp JP_PIPE  &kp PLUS        &kp RIGHT_BRACE    &kp PIPE       &kp JP_YEN        &kp RIGHT_SHIFT
                &kp RA(PRINTSCREEN)  &kp PRINTSCREEN         &kp LEFT_ALT  &kp LEFT_CONTROL         &trans      &kp BACKSPACE     &trans   &trans                       &trans             &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp TAB         &kp NUMBER_1  &kp NUMBER_2     &kp NUMBER_3       &kp NUMBER_4      &kp NUMBER_5                             &kp NUMBER_6  &kp NUMBER_7    &kp NUMBER_8    &kp NUMBER_9  &kp NUMBER_0     &kp F12
&kp CAPSLOCK    &kp F1        &kp F2           &kp F3             &kp F4            &kp F5                                   &kp F6        &kp F7          &kp F8          &kp F9        &kp F10          &kp F11
&kp LEFT_SHIFT  &kp HOME      &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp END           &kp F11                                  &kp F12       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp RIGHT_SHIFT
                &kp ESC       &kp LEFT_WIN     &kp LEFT_ALT       &kp LEFT_CONTROL  &kp SPACE  &kp BACKSPACE     &kp DELETE  &trans                        &trans          &trans
            >;
        };

        CURSOR {
            bindings = <
&kp TAB         &trans  &kp LG(LC(LEFT_ARROW))  &kp LG(TAB)  &kp LC(LG(RIGHT_ARROW))  &kp K_MUTE                    &trans  &trans          &kp UP_ARROW    &trans           &trans           &trans
&kp CAPSLOCK    &trans  &trans                  &down_space  &Space_Down              &trans                        &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp RIGHT_SHIFT  &trans
&kp LEFT_SHIFT  &trans  &trans                  &trans       &trans                   &trans                        &trans  &trans          &trans          &trans           &trans           &kp RIGHT_SHIFT
                &trans  &trans                  &trans       &trans                   &trans      &trans    &trans  &trans                  &trans          &to 0
            >;
        };

        AML {
            bindings = <
&kp TAB         &trans  &trans  &trans  &trans  &trans                      &trans           &trans      &trans              &mo 8                &trans       &trans
&kp CAPSLOCK    &trans  &trans  &trans  &trans  &trans                      &kp LS(LC(TAB))  &mkp MB1    &mkp MB2            &mo 6                &kp LC(TAB)  &trans
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans  &trans                      &trans           &kp LC(F4)  &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &trans       &kp RIGHT_SHIFT
                &trans  &trans  &trans  &trans  &trans  &trans     &trans   &trans                       &trans              &trans
            >;
        };

        MOUSE {
            bindings = <
&kp TAB         &trans  &trans  &trans  &trans  &trans                      &trans           &trans      &trans              &mo 8                &trans       &trans
&kp CAPSLOCK    &trans  &trans  &trans  &trans  &trans                      &kp LS(LC(TAB))  &mkp MB1    &mkp MB2            &mo 6                &kp LC(TAB)  &trans
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans  &trans                      &trans           &kp LC(F4)  &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &trans       &kp RIGHT_SHIFT
                &trans  &trans  &trans  &trans  &trans  &trans     &trans   &trans                       &trans              &trans
            >;
        };

        VSCROLL {
            bindings = <
&trans  &trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans                     &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS   &trans
&trans  &trans    &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans                     &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS  &trans
&trans  &kp HOME  &kp PAGE_DOWN           &kp PAGE_UP   &kp END                  &trans                     &kp UNDER        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER     &trans
        &trans    &trans                  &trans        &trans                   &trans  &trans     &trans  &kp NUMBER_0     &kp NUMBER_0  &kp DOT
            >;
        };

        WIRELESS {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                          &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans        &trans        &trans        &trans        &trans                                &trans          &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans        &trans                                &trans          &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
        &trans        &trans        &trans        &trans        &trans  &trans     &bootloader        &studio_unlock                &trans        &trans
            >;
        };

        HSCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans
            >;
        };
    };
};
